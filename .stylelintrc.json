{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": "^(o|c|u)-[a-z0-9]+(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)?(?:--[a-z0-9]+(?:-[a-z0-9]+)*)?$",
    "selector-max-id": 0,
    "selector-max-type": 0,
    "max-nesting-depth": 3,
    "declaration-no-important": true,
    "color-function-notation": "modern",
    "alpha-value-notation": "percentage"
  },
  "overrides": [
    {
      "files": ["**/4-elements/**/*.scss"],
      "rules": {
        "selector-max-type": null
      }
    },
    {
      "files": ["**/7-utilities/**/*.scss"],
      "rules": {
        "declaration-no-important": null
      }
    }
  ]
}
