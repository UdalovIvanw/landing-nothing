include ../data/navigation

aside#menu.c-menu(aria-label='Site menu')
  .o-container.c-menu__inner
    .c-menu__header
      a.c-menu__logo(href='#top', aria-label='Nothing home')
        include ../includes/Logo.svg

      a.c-menu__close(href='#top', aria-label='Close menu')
        include ../includes/Icon-Close.svg

    nav.c-menu__nav(aria-label='Menu links')
      ul.c-menu__list
        each link in menuLinks
          li.c-menu__item
            a.c-menu__link(href=link.href)= link.label

    .c-menu__contact
      a.c-menu__phone(href=contactDetails[0].href)= contactDetails[0].value
      a.c-menu__order(href=contactDetails[0].href) Call to order
