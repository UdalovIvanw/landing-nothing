mixin picture(name, alt, width, height, sizes = '100vw', imgClass = '', isLcp = false)
  - const base = '/src/assets/images/' + name;
  - const avifSet = `${base}-400.avif 400w, ${base}-800.avif 800w, ${base}-1400.avif 1400w`;
  - const webpSet = `${base}-400.webp 400w, ${base}-800.webp 800w, ${base}-1400.webp 1400w`;
  - const pngSet = `${base}-400.png 400w, ${base}-800.png 800w, ${base}-1400.png 1400w`;
  picture
    source(srcset=avifSet, sizes=sizes, type='image/avif')
    source(srcset=webpSet, sizes=sizes, type='image/webp')
    img(
      class=imgClass,
      src=`${base}-800.png`,
      srcset=pngSet,
      sizes=sizes,
      alt=alt,
      width=width,
      height=height,
      loading=isLcp ? null : 'lazy',
      fetchpriority=isLcp ? 'high' : null
    )

mixin art-picture(sources, dimensions, alt, pictureClass = '', imgClass = '', isLcp = false)
  - const desk = '/src/assets/images/' + sources.desktop;
  - const tab = '/src/assets/images/' + sources.tablet;
  - const mob = '/src/assets/images/' + sources.mobile;
  picture(class=pictureClass)
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.avif`,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height,
      type='image/avif'
    )
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.webp`,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height,
      type='image/webp'
    )
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.png`,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.avif`,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height,
      type='image/avif'
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.webp`,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height,
      type='image/webp'
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.png`,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height
    )
    source(srcset=`${mob}.avif`, type='image/avif')
    source(srcset=`${mob}.webp`, type='image/webp')
    img(
      class=imgClass,
      src=`${mob}.png`,
      alt=alt,
      width=dimensions.mobile.width,
      height=dimensions.mobile.height,
      loading=isLcp ? null : 'lazy',
      fetchpriority=isLcp ? 'high' : null
    )
