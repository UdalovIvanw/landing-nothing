mixin picture(name, alt, width, height, sizes = '100vw', imgClass = '', isLcp = false)
  - const basePath = '/images/' + name;
  picture
    source(srcset=`${basePath}.avif`, sizes=sizes, type='image/avif')
    source(srcset=`${basePath}.webp`, sizes=sizes, type='image/webp')
    img(
      class=imgClass,
      src=`${basePath}.png`,
      alt=alt,
      width=width,
      height=height,
      loading=isLcp ? null : 'lazy',
      fetchpriority=isLcp ? 'high' : null
    )

mixin art-picture(sources, dimensions, alt, sizes = '100vw', pictureClass = '', imgClass = '', isLcp = false)
  - const desk = '/images/' + sources.desktop;
  - const tab = '/images/' + sources.tablet;
  - const mob = '/images/' + sources.mobile;
  picture(class=pictureClass)
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.avif`,
      sizes=sizes,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height,
      type='image/avif'
    )
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.webp`,
      sizes=sizes,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height,
      type='image/webp'
    )
    source(
      media='(min-width: 1260px)',
      srcset=`${desk}.png`,
      sizes=sizes,
      width=dimensions.desktop.width,
      height=dimensions.desktop.height
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.avif`,
      sizes=sizes,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height,
      type='image/avif'
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.webp`,
      sizes=sizes,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height,
      type='image/webp'
    )
    source(
      media='(min-width: 744px)',
      srcset=`${tab}.png`,
      sizes=sizes,
      width=dimensions.tablet.width,
      height=dimensions.tablet.height
    )
    source(srcset=`${mob}.avif`, sizes=sizes, type='image/avif')
    source(srcset=`${mob}.webp`, sizes=sizes, type='image/webp')
    img(
      class=imgClass,
      src=`${mob}.png`,
      alt=alt,
      width=dimensions.mobile.width,
      height=dimensions.mobile.height,
      loading=isLcp ? null : 'lazy',
      fetchpriority=isLcp ? 'high' : null
    )
