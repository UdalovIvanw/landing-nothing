include ./picture

mixin product-card(item)
  li.c-recommended__item
    article.c-product-card
      .c-product-card__image
        - const imgMod = item.modifier ? `c-product-card__image-file c-product-card__image-file--${item.modifier}` : 'c-product-card__image-file';
        +picture(item.image, item.title, 600, 600, item.sizes, imgMod)
      h3.c-product-card__title= item.title
      p.c-product-card__desc
        if item.intro
          span.c-product-card__intro= item.intro + ' '
        = item.description
      p.c-product-card__price= item.price

mixin category-card(category)
  li.c-categories__item
    article.c-category
      .o-grid.c-category__gallery
        each photo in category.photos
          - const imgClass = `c-category__image c-category__image--${photo.slot}`;
          +art-picture(
            photo.sources,
            photo.dimensions,
            photo.alt,
            photo.sizes,
            'c-category__media',
            imgClass,
          )
      h3.c-category__title= category.title
